generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  discordId     String   @unique
  username      String
  discriminator String
  avatar        String?
  globalName    String?
  accentColor   Int?
  bannerColor   String?
  locale        String?
  mfaEnabled    Boolean
  premiumType   Int?
  publicFlags   Int?
  flags         Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastName      String
  firstName     String
  email         String   @unique

  gameRegistrations GameRegistration[]
  gameResults       GameResult[]

  sector   Sector? @relation(fields: [sectorId], references: [id])
  sectorId String?
}

model Sector {
  id   String @id @default(uuid())
  Name String

  users User[]
}

model GameType {
  id    String @id @default(uuid())
  name  String
  games Game[]
}

model Game {
  id          String   @id @default(uuid())
  name        String
  description String?
  gameTypeId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gameType GameType @relation(fields: [gameTypeId], references: [id])

  registrations GameRegistration[]

  results GameResult[]
}

model GameRegistration {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}

model GameResult {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  score     Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
}
